# enzymes_UPO — what stays out of git.
#
# Same tiered rule as the repo root .gitignore: code and small evidence in
# git, large or regenerable data on /bigdata. The specifics here:

# Whole-BFD scoring run: ~85 MB and growing, regenerable from
# upo_sites/slurm/run_bfd.sh plus the BFD seqdb. Chunked inputs and outputs.
data/bfd_full/

# SLURM .out/.err for the chunked runs.
logs/

# Publisher supplement (9.3 MB) and its extracted figures (23 MB). Both are
# downloadable from the URL recorded in CALIBRATION_MATRIX.md section 1.
# The two tables transcribed BY HAND from those figures are NOT ignored --
# active_site_S2.tsv and t1_peroxygenase_S8.tsv are committed, because they
# are not recoverable without redoing the transcription.
data/calib_dl/supp1.docx
data/calib_dl/figs/

__pycache__/
*.pyc
scratch_x/

# 2 MB LOCUSTAG->taxonomy lookup, regenerated from BFD samples.parquet.
.lineage.tsv

# G3 regulatory analysis: promoter sequences, STREME output and the downloaded
# motif database. 133 MB, all regenerable from upo_reg/bin/promoters.sh and
# run_streme_contrasts.sh plus the BFD genome_annotation scaffolds. The JASPAR
# file is a straight download (URL in PLAN.md section 4.2).
# The small derived tables ARE committed -- see the negations below.
data/g3/*
!data/g3/rep_clade_lineage.tsv

# Novelty search: DIAMOND-vs-nr hits and the dereplicated FASTAs.
data/bfd_full/

# Scratch test output from upo_sites development.
upo_sites/test/
.tmp/

# Phylogenetic placement: EPA output and intermediates. The reference alignment,
# reference tree, labels and the derived per-query clade table ARE committed.
data/placement/*
!data/placement/ref_aln.filtered.fa
!data/placement/ref_labels.tsv
!data/placement/reftree.raxml.bestTree
!data/placement/reftree_bootstrap.support
!data/placement/placement_clades.tsv
!data/placement/matched_identity_validation.tsv
