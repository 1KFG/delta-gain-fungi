/*
 * genome_classify profile: Stage 1 label-free genome classification.
 *
 * Apptainer, not module load: Fungi_BFD/nextflow/conf/profile_ANI.config
 * documents that module-based skani/mash hit a squashfuse-timeout failure
 * mode under this pipeline's task-submission concurrency (~23% task failure
 * rate on a real run), fixed by switching to pre-built Apptainer SANDBOX
 * images (a plain bind-mounted directory, no FUSE/squashfuse mount at all).
 * DeltaGain reuses those same already-built, already-cached sandboxes rather
 * than re-solving a problem that's already fixed.
 *
 * Bind-mount note (also from profile_ANI.config): bind projectDir's REAL
 * (symlink-resolved) path — Apptainer cannot create a bind mount point nested
 * inside an already-bound parent directory on this GPFS mount.
 */

apptainer.enabled   = true
singularity.enabled = false
apptainer.runOptions = "--bind ${projectDir.toRealPath()} \${SCRATCH:+--bind \$SCRATCH:\$SCRATCH} --bind /srv/projects/db:/srv/projects/db"

workDir = "${launchDir}/work/genome_classify"

params {
    // Resolved independently here rather than relying on
    // DeltaGain/nextflow.config's params.singularity_cache — confirmed live
    // 2026-09-07 that a `-c`-supplied config's params{} block cannot see a
    // params.x value set by the auto-loaded root nextflow.config via string
    // interpolation (reproduced in an isolated minimal repro; params.x
    // resolves to the literal string "null" instead). This is a real
    // Nextflow config-merging limitation, not specific to this project --
    // the original single-repo includeConfig-based approach never hit it
    // (same continuous parse), but the cross-repo `-c` mechanism this split
    // requires does. Fix: this project config resolves its own env-derived
    // values rather than depending on cross-file params propagation.
    singularity_cache = [
        System.getenv('NXF_APPTAINER_CACHEDIR'),
        System.getenv('NXF_SINGULARITY_CACHEDIR'),
        System.getenv('APPTAINER_CACHEDIR'),
        System.getenv('SINGULARITY_CACHEDIR')
    ].find { it }

    // Reused directly from the existing annotation pipeline -- NOT
    // reinvented here (see genome_classify.nf header comment).
    samples    = "/bigdata/stajichlab/shared/projects/BFD/Fungi_BFD_runs/samples.csv"
    genome_dir = "/bigdata/stajichlab/shared/projects/BFD/Fungi_BFD_runs/input_clean_genomes"
    outdir     = "${launchDir}/results/genome_classify"

    // Pre-built sandboxes already staged and proven working for these exact
    // tools (see Fungi_BFD/nextflow/conf/profile_ANI.config) — reused as-is.
    // Override on CLI with a docker:// URI if a newer build is needed.
    mash_container    = "${params.singularity_cache}/mash_2.3--hb105d93_10.sandbox"
    skani_container   = "${params.singularity_cache}/skani_0.3.2--h79ce301_0.sandbox"
    // Unified 2026-09-09: python_container now points at the .sif (not the
    // sandbox above) to match the single generic Python image used
    // everywhere else in the pipeline (verified working: Python 3.12.14,
    // pip 25.0.1) -- the shared cache has several redundant generic-python
    // artifacts (sandbox, multiple .img builds, this .sif); standardizing
    // on one across both profile configs rather than leaving it ambiguous
    // which is authoritative.
    python_container   = "${params.singularity_cache}/python_3.12.sif"

    mash_kmer        = 21
    mash_sketch_size = 10000
    prefilter_ani    = 80.0   // mash-ANI%% floor for drawing a union-find edge;
                               // below this mash distance itself is unreliable

    skani_preset      = 'fast'   // BFD genomes are contiguous chromosome-level
                                  // assemblies -- fast preset is accurate here
                                  // (same rationale as Fungi_BFD/nextflow's
                                  // profile_ANI.config)
    skani_preset_flag = '--fast'
    skani_min_af      = 15

    ani_cluster_threshold = 95.0   // >= this + same label -> redundant_strain
    ani_outlier_threshold = 90.0   // below this -> unresolved_below_ani_floor
                                    // (fungal species boundaries vary by lineage;
                                    // see design doc -- revisit per-lineage if
                                    // this fixed threshold proves too coarse)
}

process {
    withLabel: 'mash_sketch' {
        container      = params.mash_container
        cpus           = 2
        memory         = '6 GB'
        time           = '1 h'
        queue          = 'short'
        stageInMode    = 'symlink'
    }

    withLabel: 'mash_prefilter' {
        // cpus/memory/time set dynamically in the process (mashCpusFor/
        // mashMemoryFor/mashTimeFor, lib/utils.nf) from the true genome count
        // (~22k) -- do not override cpus/memory/time here, only queue.
        container      = params.mash_container
        queue          = { task.attempt == 1 ? 'epyc' : 'highmem' }
        stageInMode    = 'symlink'
    }

    withLabel: 'components' {
        container    = params.python_container
        cpus         = 2
        memory       = '16 GB'   // holds the full mash_dist.tsv in memory
        time         = '4 h'
        queue        = 'epyc'
    }

    withLabel: 'skani' {
        // cpus/memory/time set dynamically per-component (skaniCpusFor/
        // skaniMemoryFor/skaniTimeFor, lib/utils.nf) from that component's
        // genome count -- only queue is fixed here.
        container      = params.skani_container
        queue          = { task.attempt == 1 ? 'short' : task.attempt == 2 ? 'epyc' : 'highmem' }
        stageInMode    = 'symlink'
    }

    withLabel: 'classify' {
        container    = params.python_container
        cpus         = 1
        memory       = '8 GB'
        time         = '2 h'
        queue        = 'short'
    }
}

trace {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/genome_classify_trace.${params.trace_report_suffix}.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,tag'
}
report {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/genome_classify_report.${params.trace_report_suffix}.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/genome_classify_timeline.${params.trace_report_suffix}.html"
    overwrite = true
}
