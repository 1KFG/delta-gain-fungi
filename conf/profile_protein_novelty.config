/*
 * protein_novelty profile: Stage 3 (see protein_novelty.nf and README.md for
 * what's wired vs. still to build).
 *
 * SAFETY DEFAULT: uniprot_test_records defaults to a small number, NOT 0
 * (0 = unbounded full fungi pull). Override explicitly with
 * `--uniprot_test_records 0` only when you actually intend the full pull --
 * do not flip this default casually.
 *
 * SAFETY DEFAULT (2026-09-08): n_test also defaults to a small pilot number
 * here (BFD-side extraction/dereplication/novelty-screen, not 0/unbounded),
 * per HANDOFF.md item 2's plan to validate at meaningfully larger-than-toy
 * scale (50-100 genomes) before ever pointing this at the full ~22k set --
 * most of which isn't annotated yet anyway (BUILD_PEP_MANIFEST reports the
 * real annotated-vs-total count each run). Override explicitly with
 * `--n_test 0` only when you actually intend the unbounded run.
 */

workDir = "${launchDir}/work/protein_novelty"

params {
    // Resolved independently here, not via DeltaGain/nextflow.config's
    // params.singularity_cache -- a `-c`-supplied config's params{} block
    // can't see a params.x value set by the auto-loaded root nextflow.config
    // via string interpolation (confirmed live 2026-09-07; see
    // profile_genome_classify.config's identical comment for the full
    // explanation and the isolated repro that confirmed it).
    singularity_cache = [
        System.getenv('NXF_APPTAINER_CACHEDIR'),
        System.getenv('NXF_SINGULARITY_CACHEDIR'),
        System.getenv('APPTAINER_CACHEDIR'),
        System.getenv('SINGULARITY_CACHEDIR')
    ].find { it }

    outdir              = "${launchDir}/results/protein_novelty"
    refdb_outdir        = "${launchDir}/results/protein_novelty/refdb"
    uniprot_staging_dir = "${launchDir}/lib/uniprot_fungi"   // matches Fungi_BFD/nextflow's lib/swissprot staging convention

    fungi_taxid           = 4751    // NCBI Taxonomy id for Fungi
    uniprot_test_records  = 20      // SAFETY DEFAULT (REST smoke-test path only) — see header comment above

    // MMSEQS_LINCLUST: identity/coverage per the design doc's Step 2
    // (~90-95% identity dereplication threshold). Container confirmed already
    // cached on this cluster (2026-09-06) — not built for this project.
    mmseqs2_container = "${params.singularity_cache}/depot.galaxyproject.org-singularity-mmseqs2-17.b804f--hd6d6fdc_1.img"
    mmseqs_min_seq_id = 0.95
    mmseqs_coverage   = 0.90
    mmseqs_cov_mode   = 0

    // Reuse the already-built real UniProt-fungi refdb (15,089,757 seqs,
    // built 2026-09-07 before the DeltaGain/DeltaGain_Fungi split) instead
    // of re-deriving it -- see protein_novelty.nf's header comment. Set to
    // '' explicitly to force a real FTP+linclust re-derivation.
    uniprot_fungi_nr_fasta = '/bigdata/stajichlab/shared/projects/BFD/DeltaGain/results/protein_novelty/uniprot_fungi_nr.fasta'

    // Already-staged, taxonomy-aware DIAMOND db.
    nr_cluster_dmnd      = '/srv/projects/db/ncbi/diamond/20260128/nr_cluster_seq.dmnd'
    // Unified 2026-09-09 (was 2.2.5 here, 2.2.6 in a separate
    // diamond_container_2_2_6 param used only by DIAMOND_CLUSTER): every
    // DIAMOND-using process now shares this one image/version. 2.2.6 was
    // already required for DIAMOND_CLUSTER's --cluster-steps/--round-coverage
    // cascaded-clustering support (DIAMOND DeepClust, Buchfink et al. 2026
    // Nat Methods) and its --reps+--out crash workaround (see
    // modules/dedup/DIAMOND_CLUSTER's header); no known reason recorded for
    // keeping MAKEDB/SEARCH_UNIPROT/NOVELTY_SCREEN on the older 2.2.5.
    diamond_container    = "${params.singularity_cache}/diamond_2.2.6--he361c42_0.sif"
    diamond_evalue       = 1e-5
    diamond_sensitivity  = 'sensitive'
    diamond_max_targets  = 10

    // Matched to MMSEQS_LINCLUST's existing 95%/90% thresholds for an
    // apples-to-apples comparison (COMPARE_CLUSTERINGS), not independently
    // tuned to DeepClust's own published recipe.
    diamond_cluster_approx_id     = 95
    diamond_cluster_mutual_cover  = 90

    // BFD-side protein extraction (HANDOFF.md items 1/3) -- Fungi_BFD_runs'
    // funannotate output, mapped ASMID -> pep file via BUILD_PEP_MANIFEST
    // (see that module + bin/build_pep_manifest.py for the makeSampleTag
    // naming rule this reuses). Confirmed by user 2026-09-08: incomplete
    // snapshot (several thousand of the ~22k genomes annotated so far, not
    // the full set yet) -- exactly why a 50-100 genome pilot (n_test above)
    // makes sense before pointing this at everything currently annotated.
    samples  = "/bigdata/stajichlab/shared/projects/BFD/Fungi_BFD_runs/samples.csv"
    pep_dir  = "/bigdata/stajichlab/shared/projects/BFD/Fungi_BFD_runs/input/pep"
    n_test   = 100   // SAFETY DEFAULT — see header comment above

    seqkit_container    = "${params.singularity_cache}/depot.galaxyproject.org-singularity-seqkit-2.9.0--h9ee0642_0.img"
    // Unified 2026-09-09: same python_3.12.sif as profile_genome_classify.config
    // (see that file's comment) -- one generic Python image referenced
    // consistently across both profiles, not the sandbox.
    python_container     = "${params.singularity_cache}/python_3.12.sif"
    diamond_chunk_size   = 20000   // sequences per DIAMOND_NOVELTY_SCREEN/DIAMOND_SEARCH_UNIPROT chunk
}

apptainer.enabled   = true
singularity.enabled = false
apptainer.runOptions = "--bind ${projectDir.toRealPath()} \${SCRATCH:+--bind \$SCRATCH:\$SCRATCH} --bind /srv/projects/db:/srv/projects/db"

process {
    withLabel: 'fetch_uniprot' {
        // `short` caps at 2h -- confirmed live 2026-09-06 that requesting 4h
        // here made sbatch reject the submission outright ("Requested time
        // limit is invalid"), not just queue/fail. This label only ever runs
        // the small REST smoke test (seconds), so 2h is ample headroom.
        cpus   = 1
        memory = '2 GB'
        time   = '2 h'
        queue  = 'short'
    }

    withLabel: 'fetch_uniprot_ftp' {
        cpus   = 1
        memory = '4 GB'
        // uniprot_trembl_fungi.dat.gz is ~13 GB -- 6h per user request
        // (2026-09-07); -C - (resume) makes a retry cheap if that's not
        // enough for a slow/throttled connection. queue='batch' also per
        // user request for the download step.
        time   = '6 h'
        queue  = 'batch'
    }

    withLabel: 'convert_dat' {
        // Streaming parse (Bio.SwissProt.parse is a generator, not a
        // whole-file load) -- memory stays modest even for the 13 GB trembl
        // file; time is dominated by parsing ~17.5M records.
        cpus   = 1
        memory = '16 GB'
        time   = '24 h'
        queue  = 'epyc'
    }

    withLabel: 'combine_uniprot' {
        // same `short` 2h-cap fix as 'fetch_uniprot' above
        cpus   = 1
        memory = '4 GB'
        time   = '2 h'
        queue  = 'short'
    }

    withLabel: 'mmseqs_linclust' {
        // queue='epyc', NOT 'highmem': confirmed live 2026-09-07 that
        // `highmem`'s nodes are mixed hardware -- h[01-06] are Ivy Bridge
        // (2012-13, AVX1 only, no AVX2) and only h07 is modern
        // (Sapphire Rapids, AVX2+). The containerized mmseqs2 binary
        // requires AVX2 and crashes with "Illegal instruction (core dumped)"
        // (exit 132) on the Ivy Bridge nodes -- hit this for real: all 3
        // retry attempts landed on h06 and all 3 crashed identically.
        // `epyc` (r[21-40], AMD Milan, ~950GB RAM / 256 cpus EACH, 20 nodes)
        // is uniformly modern (no SIGILL risk) and has far more scheduling
        // headroom than pinning to the single qualifying highmem node would
        // (e.g. via a `-C sapphire` constraint) -- strictly better fix than
        // constraining to h07 alone.
        container = params.mmseqs2_container
        cpus      = 32
        memory    = '256 GB'   // ~17.5M sequences; linclust memory scales with
                                // total residues + k-mer index, not just seq count
                                // -- trivial fit in epyc's ~950GB/node anyway
        time      = '48 h'
        queue     = 'epyc'
    }

    withLabel: 'diamond' {
        cpus   = 32
        memory = '64 GB'   // nr_cluster_seq.dmnd is ~195 GB on disk; needs real RAM headroom
        time   = '24 h'
        queue  = 'epyc'
    }

    // MMSEQS_LINCLUST_BFD's pilot-scale (n_test=100 genomes, likely well
    // under 2M proteins) input is orders of magnitude smaller than the
    // UniProt-fungi set 'mmseqs_linclust' above is sized for (~17.5M
    // sequences, 256GB/48h/32cpu) -- withName overrides the shared label's
    // resources for this specific process alias (see protein_novelty.nf's
    // `include { MMSEQS_LINCLUST as MMSEQS_LINCLUST_BFD }`) rather than
    // over-requesting epyc capacity a pilot run doesn't need. Revisit
    // upward once run against the full annotated set, not just the pilot.
    withName: 'MMSEQS_LINCLUST_BFD' {
        container = params.mmseqs2_container
        cpus      = 8
        memory    = '32 GB'
        time      = '4 h'
        queue     = 'epyc'
    }

    withLabel: 'build_pep_manifest' {
        container = params.python_container
        cpus      = 1
        memory    = '2 GB'
        time      = '1 h'
        queue     = 'short'
    }

    withLabel: 'combine_bfd_proteins' {
        container = params.python_container
        cpus      = 1
        memory    = '8 GB'
        time      = '2 h'
        queue     = 'short'
    }

    withLabel: 'split_fasta' {
        container = params.seqkit_container
        cpus      = 1
        memory    = '4 GB'
        time      = '1 h'
        queue     = 'short'
    }

    withLabel: 'diamond_makedb' {
        cpus   = 8
        memory = '32 GB'
        time   = '4 h'
        queue  = 'epyc'
    }

    withLabel: 'bin_novelty_hits' {
        container = params.python_container
        cpus      = 1
        memory    = '4 GB'
        time      = '1 h'
        queue     = 'short'
    }

    // Comparison-only branch (2026-09-08) -- same pilot-scale sizing
    // rationale as MMSEQS_LINCLUST_BFD above, not the full UniProt-scale
    // 'mmseqs_linclust' resources.
    withLabel: 'diamond_cluster' {
        cpus   = 8
        memory = '32 GB'
        time   = '4 h'
        queue  = 'epyc'
    }

    withLabel: 'extract_cluster_reps' {
        // Split out of DIAMOND_CLUSTER 2026-09-08: the DIAMOND biocontainer
        // has no python3 at all ("env: can't execute 'python3'") -- this
        // step needs the python container instead.
        container = params.python_container
        cpus      = 1
        memory    = '8 GB'
        time      = '2 h'
        queue     = 'short'
    }

    withLabel: 'compare_clusterings' {
        container = params.python_container
        cpus      = 1
        memory    = '8 GB'
        time      = '1 h'
        queue     = 'short'
    }
}
