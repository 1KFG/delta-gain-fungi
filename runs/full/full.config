// Full-set (all annotated genomes) overrides, layered after the project conf.
// Sizing from the 2000-genome run (HANDOFF 2026-10-24) scaled ~11.7x linearly.
// 'short' partition caps at 2 h, so any step that may run longer uses 'batch'.
process {
    withName: 'COMBINE_BFD_PROTEINS' { queue = 'batch'; time = '8 h';  memory = '8 GB'   }  // 8m23s at 20M
    withName: 'MMSEQS_LINCLUST_BFD'  { memory = '400 GB'; time = '24 h' }                    // 25.6 GB at 20M -> ~300 GB
    withName: 'SPLIT_FASTA'          { queue = 'batch'; time = '6 h';  memory = '8 GB'   }  // guess
    withName: 'BIN_NOVELTY_HITS'     { queue = 'batch'; time = '12 h'; memory = '64 GB'  }  // guess: ~126M reps vs 4 GB at pilot
}
